index 88064c05..22013e99 100644
--- a/c2me-opts-dfc/src/main/java/com/ishland/c2me/opts/dfc/common/ast/McToAst.java
+++ b/c2me-opts-dfc/src/main/java/com/ishland/c2me/opts/dfc/common/ast/McToAst.java
@@ -31,6 +31,7 @@ import com.ishland.c2me.opts.dfc.common.ast.binary.MaxShortNode;
 import com.ishland.c2me.opts.dfc.common.ast.binary.MinNode;
 import com.ishland.c2me.opts.dfc.common.ast.binary.MinShortNode;
 import com.ishland.c2me.opts.dfc.common.ast.binary.MulNode;
+import com.ishland.c2me.opts.dfc.common.ast.integration.tectonic.TectonicInvertParser;
 import com.ishland.c2me.opts.dfc.common.ast.misc.BeardifierNode;
 import com.ishland.c2me.opts.dfc.common.ast.misc.CacheLikeNode;
 import com.ishland.c2me.opts.dfc.common.ast.misc.ConstantNode;
@@ -166,6 +167,11 @@ public class McToAst {
             case DensityFunctionTypes.Beardifier f -> new BeardifierNode(f);
 
             default -> {
+                {
+                    AstNode res = TectonicInvertParser.tryParseInvert(df);
+                    if (res != null) yield res;
+                }
+
                 delegateStatistics.computeIfAbsent(df.getClass(), unused -> new LongAdder()).increment();
                 yield new DelegateNode(df);
             }
diff --git a/c2me-opts-dfc/src/main/java/com/ishland/c2me/opts/dfc/common/ast/integration/tectonic/TectonicInvertParser.java b/c2me-opts-dfc/src/main/java/com/ishland/c2me/opts/dfc/common/ast/integration/tectonic/TectonicInvertParser.java

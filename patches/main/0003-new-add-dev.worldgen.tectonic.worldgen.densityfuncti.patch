+package com.ishland.c2me.opts.dfc.common.ast.integration.tectonic;
+
+import com.ishland.c2me.opts.dfc.common.ast.AstNode;
+import com.ishland.c2me.opts.dfc.common.ast.McToAst;
+import com.ishland.c2me.opts.dfc.common.ast.binary.DivNode;
+import com.ishland.c2me.opts.dfc.common.ast.misc.ConstantNode;
+import net.fabricmc.loader.api.FabricLoader;
+import net.minecraft.world.gen.densityfunction.DensityFunction;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.lang.invoke.MethodHandle;
+import java.lang.invoke.MethodHandles;
+import java.lang.invoke.MethodType;
+
+public class TectonicInvertParser {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(TectonicInvertParser.class);
+
+    private static final Class<?> CLASS_Invert;
+    private static final MethodHandle MH_input;
+    private static final boolean AVAILABLE;
+
+    static {
+        Class<?> class_Invert = null;
+        MethodHandle mh_input = null;
+        boolean available = false;
+
+        if (FabricLoader.getInstance().isModLoaded("tectonic")) {
+            try {
+                class_Invert = Class.forName("dev.worldgen.tectonic.worldgen.densityfunction.Invert");
+                mh_input = MethodHandles.lookup().findVirtual(
+                        class_Invert,
+                        "input",
+                        MethodType.methodType(DensityFunction.class)
+                );
+
+                LOGGER.info("Binding to tectonic dev.worldgen.tectonic.worldgen.densityfunction.Invert density function");
+                available = true;
+            } catch (Throwable t) {
+                LOGGER.warn("Failed to bind to tectonic dev.worldgen.tectonic.worldgen.densityfunction.Invert density function", t);
+            }
+        }
+
+        CLASS_Invert = class_Invert;
+        MH_input = mh_input;
+        AVAILABLE = available;
+    }
+
+    public static AstNode tryParseInvert(DensityFunction function) {
+        if (!AVAILABLE) return null;
+
+        if (CLASS_Invert.isInstance(function)) {
+            try {
+                return new DivNode(new ConstantNode(1.0), McToAst.toAst((DensityFunction) MH_input.invoke(function)));
+            } catch (Throwable e) {
+                throw new RuntimeException(e);
+            }
+        }
+
+        return null;
+    }
+
+}

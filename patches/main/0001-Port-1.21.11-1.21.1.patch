+        if (instance instanceof IFastChunkHolder fastChunkHolder) {
+            return fastChunkHolder.c2me$immediateWorldChunk();
+        } else {
+            return instance.getAccessibleFuture().getNow(ChunkHolder.UNLOADED_WORLD_CHUNK).orElse(null);
+        }
+    }
+
+}

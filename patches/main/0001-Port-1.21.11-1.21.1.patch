+package com.ishland.c2me.opts.dfc.common.gen.backports;
+
+import net.minecraft.util.dynamic.CodecHolder;
+import net.minecraft.util.math.MathHelper;
+import net.minecraft.world.gen.densityfunction.DensityFunction;
+
+public record FindTopSurface(DensityFunction delegate, DensityFunction upperBound, int lowerBound, int cellHeight) implements DensityFunction {
+
+    @Override
+    public double sample(final DensityFunction.NoisePos pos) {
+        int topY = MathHelper.floor(this.upperBound.sample(pos) / this.cellHeight) * this.cellHeight;
+        if (topY <= this.lowerBound) {
+            return this.lowerBound;
+        } else {
+            for (int blockY = topY; blockY >= this.lowerBound; blockY -= this.cellHeight) {
+                if (this.delegate.sample(new DensityFunction.UnblendedNoisePos(pos.blockX(), blockY, pos.blockZ())) > 0.0) {
+                    return blockY;
+                }
+            }
+
+            return this.lowerBound;
+        }
+    }
+
+    @Override
+    public void fill(final double[] densities, final DensityFunction.EachApplier applier) {
+        applier.fill(densities, this);
+    }
+
+    @Override
+    public DensityFunction apply(final DensityFunction.DensityFunctionVisitor visitor) {
+        return visitor.apply(new FindTopSurface(this.delegate.apply(visitor), this.upperBound.apply(visitor), this.lowerBound, this.cellHeight));
+    }
+
+    @Override
+    public double minValue() {
+        return this.lowerBound;
+    }
+
+    @Override
+    public double maxValue() {
+        return Math.max(this.lowerBound, this.upperBound.maxValue());
+    }
+
+    @Override
+    public CodecHolder<? extends DensityFunction> getCodecHolder() {
+        throw new UnsupportedOperationException();
+    }
+
+}
